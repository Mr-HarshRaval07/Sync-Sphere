# ==============================================================================
# SyncSphere AI - Environment Variables Template
# Copy this file to .env and fill in the secrets for local development.
# ==============================================================================

# Application settings
SYNCSPHERE_APP_NAME=
SYNCSPHERE_ENVIRONMENT=
SYNCSPHERE_DEBUG=
SYNCSPHERE_HOST=
SYNCSPHERE_PORT=
SYNCSPHERE_WORKERS=

# MongoDB Connection
# In Docker compose, we use the service name "mongodb"
SYNCSPHERE_MONGODB_URI=
SYNCSPHERE_MONGODB_DATABASE=
SYNCSPHERE_MONGODB_MAX_POOL_SIZE=

# Redis Connection
# In Docker compose, we use the service name "redis"
SYNCSPHERE_REDIS_URI=
SYNCSPHERE_REDIS_MAX_CONNECTIONS=

# JWT Configuration
# For local dev, a 256-bit secret is fine. In production, use RS256 private/public key.
SYNCSPHERE_JWT_SECRET=
SYNCSPHERE_JWT_ALGORITHM=
SYNCSPHERE_JWT_ACCESS_TOKEN_TTL=
SYNCSPHERE_JWT_REFRESH_TOKEN_TTL=

# Master Cryptographic Encryption Key (for decrypting connector credentials)
# Must be a 32-byte url-safe base64 key. Generate using: cryptography.fernet.Fernet.generate_key()
SYNCSPHERE_MASTER_ENCRYPTION_KEY=

# LLM Providers Configuration
SYNCSPHERE_LLM_PROVIDER=
SYNCSPHERE_LLM_API_KEY=
SYNCSPHERE_LLM_MODEL=
SYNCSPHERE_LLM_MAX_TOKENS=

# Vector & Embeddings Configuration
SYNCSPHERE_EMBEDDING_PROVIDER=
SYNCSPHERE_EMBEDDING_API_KEY=
SYNCSPHERE_EMBEDDING_MODEL=
SYNCSPHERE_EMBEDDING_DIMENSIONS=

# Rate Limiting & Execution Config
SYNCSPHERE_RATE_LIMIT_REQUESTS_PER_MINUTE=
SYNCSPHERE_EXECUTION_DEFAULT_TIMEOUT=
SYNCSPHERE_EXECUTION_MAX_RETRIES=
SYNCSPHERE_EXECUTION_CHECKPOINT_ENABLED=

# Feature Flags
SYNCSPHERE_FEATURE_REFLECTION_ENABLED=
SYNCSPHERE_FEATURE_APPROVAL_ENABLED=

# slack connection
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# jira
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=

# github
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=


# notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
NOTION_AUTH_URL=
NOTION_TOKEN_URL=

NOTION_API_BASE_URL=
NOTION_API_VERSION=
# github Outh
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# GitHub OAuth
APP_GITHUB_CLIENT_ID=
APP_GITHUB_CLIENT_SECRET=
APP_GITHUB_REDIRECT_URI=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=

FRONTEND_URL=
# google auth

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

OPENROUTER_API_KEY=
PROJECT_NAME=
PROJECT_NUMBER=
